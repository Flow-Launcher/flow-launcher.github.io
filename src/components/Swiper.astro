---
import { Swiper as AstroSwiper, SwiperWrapper, SwiperButtonPrev, SwiperButtonNext, SwiperPagination } from "astro-swiper";
import type { AstroSwiperOptions } from "astro-swiper";

interface Props {
  class?: string;
  noLoop?: boolean;
  containsPlugins?: boolean;
}

const {
  class: className = "",
  noLoop = false,
  containsPlugins = false,
  ...rest
} = Astro.props;

const options: AstroSwiperOptions = {
  loop: noLoop !== true,

  grabCursor: true,

  slidesPerView: 1,
  spaceBetween: containsPlugins ? 30 : 10,
  breakpoints: {
    640: {
      slidesPerView: 2,
      spaceBetween: containsPlugins ? 30 : 20,
    },
    1024: {
      slidesPerView: 3,
      spaceBetween: 30,
    },
  },

  pagination: {
    el: '.swiper-pagination',
    bulletClass: 'swiper-pagination-bullet',
  },

  navigation: {
    nextEl: '.swiper-button-next',
    prevEl: '.swiper-button-prev',
  },
};
---

<div class:list={["swiper-container", className]} {...rest}>
  <AstroSwiper options={options}>
    <SwiperWrapper>
      <slot/>
    </SwiperWrapper>

  </AstroSwiper>
  <SwiperButtonPrev/>
  <SwiperButtonNext/>

  <SwiperPagination/>
</div>

<style lang="scss">
@use "$styles/breakpoints";

.swiper-container {
    position: relative;
    padding: 10px 50px 40px;
}

.swiper {
    border-radius: 8px;
}

.swiper-container.containsPlugins .swiper {
  padding: 4px 24px 32px;
  overflow-x: hidden;
  overflow-y: visible;
}

@include breakpoints.sm {
  .swiper-container {
    padding: 10px 0 40px;

    .swiper-button-prev,
    .swiper-button-next {
      display: none !important;
    }
  }
}
</style>

<style is:global>
.swiper-pagination-bullet {
    background-color: var(--button-primary) !important;
    transition: opacity 0.2s !important;
}
</style>
